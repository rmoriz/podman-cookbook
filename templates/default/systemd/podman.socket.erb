[Unit]
Description=Podman API Socket (<%= @podman_name %>)
Documentation=man:podman-system-service(1)
PartOf=<%= @podman_name %>.service

[Socket]
ListenStream=%t/podman/podman.sock
SocketMode=0660
SocketUser=<%= @socket_user %>
SocketGroup=<%= @group %>
<%= @systemd_socket_opts %>
[Install]
WantedBy=sockets.target
